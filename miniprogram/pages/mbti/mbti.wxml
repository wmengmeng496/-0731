<view class="page">
  <view class="title">MBTI人格</view>
  <view class="subtitle">十六型人格测试，探索真我性格与匹配关系</view>
  <view wx:if="{{!result && questions.length}}" class="card active">
    <view class="muted small">第 {{index + 1}} / {{questions.length}} 题</view>
    <view class="question-title">{{questions[index].text}}</view>
    <button class="button" bindtap="answer" data-value="yes">{{questions[index].positive}}</button>
    <button class="ghost-button option" bindtap="answer" data-value="no">{{questions[index].negative}}</button>
  </view>
  <view wx:if="{{result}}" class="card active">
    <view class="mbti-code">{{result.code}}</view>
    <view class="gold type-name">{{result.nickname}} · {{result.category}}</view>
    <view class="body">{{result.desc}}</view>
    <view class="section-title">人格优势</view>
    <text wx:for="{{result.strengths}}" wx:key="*this" class="pill">{{item}}</text>
    <view class="section-title">成长提醒</view>
    <view class="body">{{result.advice}}</view>
    <button class="ghost-button option" bindtap="reset">重新测试</button>
  </view>
</view>
