<view class="page">
  <view class="title">塔罗占卜</view>
  <view class="subtitle">抽取命运之牌，洞察未来趋势与感情指引</view>

  <view class="spread-row">
    <view wx:for="{{spreads}}" wx:key="key" class="spread {{spread===item.key?'active':''}}" bindtap="chooseSpread" data-key="{{item.key}}">
      <view>{{item.name}}</view>
      <view class="muted small">{{item.desc}}</view>
    </view>
  </view>

  <view class="card">
    <textarea class="question" placeholder="可输入你想询问的问题，也可以留空" value="{{question}}" bindinput="setQuestion" />
    <button class="button" loading="{{loading}}" bindtap="draw">{{loading ? '洗牌中...' : '开始抽牌'}}</button>
  </view>

  <view wx:if="{{result}}" class="card active">
    <view class="gold overview">{{result.overview}}</view>
    <view class="tarot-grid">
      <view wx:for="{{result.cards}}" wx:key="name" class="tarot-card">
        <view class="card-face">
          <view class="card-index">{{index + 1}}</view>
          <view class="card-name">{{item.name}}</view>
          <view class="muted small">{{item.en}}</view>
        </view>
        <view class="gold small">{{item.position}}</view>
      </view>
    </view>
    <view wx:for="{{result.cards}}" wx:key="name" class="reading">
      <view class="gold">{{item.name}} · {{item.position}}</view>
      <view><text wx:for="{{item.keywords}}" wx:key="*this" class="pill">{{item}}</text></view>
      <view class="body">{{item.reading}}</view>
    </view>

    <view class="chat-box">
      <view class="section-title">继续追问</view>
      <view wx:for="{{chatMessages}}" wx:key="index" class="chat-row {{item.role}}">
        <view class="chat-bubble">
          <view class="body">{{item.content}}</view>
          <view wx:if="{{item.suggestions}}" class="suggestions">
            <text wx:for="{{item.suggestions}}" wx:key="*this" class="pill" bindtap="setFollowQuestion" data-value="{{item}}">{{item}}</text>
          </view>
        </view>
      </view>
      <textarea class="question follow" placeholder="基于这次牌面继续追问，例如：我下一步该怎么做？" value="{{followQuestion}}" bindinput="setFollowQuestion" />
      <button class="ghost-button" loading="{{loading}}" bindtap="askFollow">{{loading ? '解读中...' : '发送追问'}}</button>
    </view>
  </view>
</view>
