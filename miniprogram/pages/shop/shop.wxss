.tabs {
  display: flex;
  gap: 18rpx;
  margin: 34rpx 0;
}
.tab {
  flex: 1;
  padding: 22rpx 0;
  border: 1rpx solid #5a4735;
  border-radius: 16rpx;
  color: #8f7554;
  text-align: center;
  font-size: 26rpx;
}
.tab.active,
.temple.active {
  border-color: #c97a1f;
  color: #e9b870;
  background: rgba(201, 122, 31, 0.1);
}
.temple {
  margin-bottom: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #3d2f23;
  border-radius: 16rpx;
}
.switch-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #3d2f23;
}
.prayer-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.prayer {
  padding: 10rpx 18rpx;
  border: 1rpx solid #5a4735;
  border-radius: 999rpx;
  color: #8f7554;
  font-size: 24rpx;
}
.prayer.active {
  border-color: #c97a1f;
  color: #e9b870;
  background: rgba(201, 122, 31, 0.1);
}
.bracelet-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin: 18rpx 0 26rpx;
}
.small-preview {
  justify-content: flex-start;
}
.bead {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid rgba(249, 236, 216, 0.24);
  border-radius: 50%;
  box-shadow: inset 0 8rpx 16rpx rgba(255,255,255,0.2), 0 6rpx 12rpx rgba(0,0,0,0.28);
}
.product-name {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
}
.wecom-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-color: rgba(201, 122, 31, 0.42);
  background: rgba(201, 122, 31, 0.1);
}
.compact {
  flex: 0 0 190rpx;
  margin: 0;
  padding: 0 20rpx;
  font-size: 24rpx;
}
.wecom-qr-thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border: 8rpx solid #f9ecd8;
  border-radius: 16rpx;
  background: #fff;
}
.wecom-qr-large {
  display: block;
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto;
  border: 10rpx solid #f9ecd8;
  border-radius: 20rpx;
  background: #fff;
}
.product-image {
  position: relative;
  height: 360rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid #3d2f23;
  border-radius: 22rpx;
}
.hero-preview {
  position: absolute;
  left: 50%;
  top: 48%;
  width: 360rpx;
  transform: translate(-50%, -50%);
}
.hero-bead {
  width: 46rpx;
  height: 46rpx;
}
.image-label {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 20rpx;
  color: #e9b870;
  font-size: 24rpx;
}
.supply {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(201, 122, 31, 0.1);
  color: #e9b870;
  font-size: 22rpx;
}
.sku-line {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #3d2f23;
  color: #d4cbb8;
  font-size: 24rpx;
}
.bead-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 22rpx 0;
}
.bead-dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  flex: 0 0 34rpx;
}
.bead-info {
  flex: 1;
  min-width: 0;
}
.counter {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.counter button {
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  border: 1rpx solid #5a4735;
  border-radius: 12rpx;
  background: #0f0b08;
  color: #e9b870;
  font-size: 30rpx;
  line-height: 46rpx;
}
.counter text {
  min-width: 34rpx;
  color: #f9ecd8;
  text-align: center;
}
.quote-line {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #3d2f23;
  color: #d4cbb8;
  font-size: 26rpx;
}
.total {
  margin: 24rpx 0;
  color: #e9b870;
  font-family: "Songti SC", serif;
  font-size: 40rpx;
}
.price {
  color: #e9b870;
  font-family: "Songti SC", serif;
  font-size: 42rpx;
}
.product .ghost-button {
  margin-top: 22rpx;
}
