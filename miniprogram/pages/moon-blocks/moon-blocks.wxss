.hero {
  text-align: center;
  padding: 28rpx 0 22rpx;
}

.question-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 172rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #5a4735;
  border-radius: 18rpx;
  background: #0f0b08;
  color: #f9ecd8;
  font-size: 28rpx;
  line-height: 1.55;
}

.hint {
  margin: 18rpx 0 22rpx;
  color: #745e43;
  font-size: 22rpx;
}

.stage-card {
  overflow: hidden;
}

.stage {
  position: relative;
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  gap: 58rpx;
  border: 1rpx solid rgba(90, 71, 53, 0.8);
  border-radius: 24rpx;
  background: rgba(15, 11, 8, 0.58);
}

.cup-wrap {
  position: relative;
  z-index: 1;
  text-align: center;
}

.moon-block {
  position: relative;
  display: flex;
  width: 150rpx;
  height: 204rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid rgba(233, 184, 112, 0.32);
  border-radius: 58% 42% 54% 46% / 42% 52% 48% 58%;
  color: rgba(249, 236, 216, 0.78);
  font-size: 30rpx;
  box-shadow: 0 28rpx 48rpx rgba(0, 0, 0, 0.32);
}

.yin {
  background: linear-gradient(145deg, #8f5d32, #4f321e 52%, #21150f);
}

.yang {
  background:
    radial-gradient(circle at 48% 42%, rgba(249, 236, 216, 0.38), transparent 32%),
    linear-gradient(145deg, #a86b32, #5c3b22 54%, #20150f);
}

.ridge {
  position: absolute;
  inset: 24rpx 32rpx;
  border: 1rpx solid rgba(249, 236, 216, 0.14);
  border-radius: inherit;
}

.shine {
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  width: 38rpx;
  height: 86rpx;
  border-radius: 999rpx;
  background: rgba(249, 236, 216, 0.16);
  filter: blur(8rpx);
  transform: rotate(20deg);
}

.face-label {
  margin-top: 18rpx;
  color: #745e43;
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.cup-shadow {
  position: absolute;
  bottom: 68rpx;
  width: 300rpx;
  height: 46rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.3);
  filter: blur(10rpx);
}

.tossing {
  animation: cupToss 1.5s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
}

.settle {
  animation: cupSettle 0.6s ease-out both;
}

.shadow-moving {
  animation: cupShadow 1.5s ease-in-out infinite;
}

.empty {
  margin-top: 28rpx;
  color: #8f7554;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.result {
  margin-top: 30rpx;
  text-align: center;
}

.result-label {
  letter-spacing: 8rpx;
}

.result-name {
  color: #f9ecd8;
  font-family: "Songti SC", serif;
  font-size: 46rpx;
}

.verdict {
  margin: 8rpx 0 22rpx;
  font-size: 32rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.muted-pill {
  color: #8f7554;
  border-color: rgba(90, 71, 53, 0.88);
  background: rgba(15, 11, 8, 0.5);
}

.muted-detail {
  margin-top: 14rpx;
  color: #b8a88e;
}

.advice {
  margin: 28rpx 0;
  padding: 22rpx;
  border: 1rpx solid rgba(233, 184, 112, 0.24);
  border-radius: 18rpx;
  background: rgba(201, 122, 31, 0.08);
  text-align: left;
}

.loading-lines {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 12rpx;
}

.loading-lines view {
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(90, 71, 53, 0.72);
  animation: loadingPulse 1.1s ease-in-out infinite;
}

.loading-lines view:nth-child(2) {
  width: 88%;
}

.loading-lines view:nth-child(3) {
  width: 68%;
}

.small-lines view {
  background: rgba(233, 184, 112, 0.18);
}

@keyframes cupToss {
  0% {
    transform: translateY(34rpx) rotateX(0deg) rotateZ(-12deg);
  }
  38% {
    transform: translateY(-92rpx) rotateX(200deg) rotateZ(62deg);
  }
  70% {
    transform: translateY(-16rpx) rotateX(360deg) rotateZ(-34deg);
  }
  100% {
    transform: translateY(34rpx) rotateX(540deg) rotateZ(12deg);
  }
}

@keyframes cupSettle {
  0% {
    opacity: 0;
    transform: translateY(-24rpx) rotateZ(18deg) scale(0.94);
  }
  70% {
    opacity: 1;
    transform: translateY(6rpx) rotateZ(-4deg) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotateZ(0deg) scale(1);
  }
}

@keyframes cupShadow {
  0%, 100% {
    opacity: 0.5;
    transform: scaleX(1);
  }
  45% {
    opacity: 0.18;
    transform: scaleX(0.58);
  }
}

@keyframes loadingPulse {
  0%, 100% {
    opacity: 0.35;
  }
  50% {
    opacity: 0.85;
  }
}
