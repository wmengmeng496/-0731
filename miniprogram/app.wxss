page {
  min-height: 100%;
  background: #0f0b08;
  color: #f9ecd8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 28rpx 72rpx;
  background:
    radial-gradient(circle at 25% 8%, rgba(201, 122, 31, 0.12), transparent 28%),
    radial-gradient(circle at 82% 18%, rgba(233, 184, 112, 0.08), transparent 24%),
    #0f0b08;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(201, 122, 31, 0.24);
  border-radius: 999rpx;
  color: #e9b870;
  background: rgba(201, 122, 31, 0.07);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 28rpx;
  color: #f9ecd8;
  font-family: "Songti SC", serif;
  font-size: 56rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: #b8a88e;
  font-size: 26rpx;
  line-height: 1.7;
}

.section-title {
  margin: 44rpx 0 22rpx;
  color: #8f7554;
  font-size: 22rpx;
  letter-spacing: 8rpx;
  text-align: center;
}

.card {
  box-sizing: border-box;
  margin-bottom: 22rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(90, 71, 53, 0.92);
  border-radius: 24rpx;
  background: rgba(31, 23, 17, 0.72);
}

.card.active {
  border-color: rgba(233, 184, 112, 0.46);
  background: rgba(61, 47, 35, 0.75);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #8f7554;
}

.gold {
  color: #e9b870;
}

.small {
  font-size: 22rpx;
}

.body {
  color: #d4cbb8;
  font-size: 26rpx;
  line-height: 1.75;
}

.input,
.picker {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #5a4735;
  border-radius: 16rpx;
  background: #0f0b08;
  color: #f9ecd8;
  font-size: 28rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #b8a88e;
  font-size: 24rpx;
}

.button {
  height: 92rpx;
  border-radius: 18rpx;
  background: #a86017;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.ghost-button {
  height: 78rpx;
  border: 1rpx solid #5a4735;
  border-radius: 16rpx;
  background: transparent;
  color: #e9b870;
  font-size: 26rpx;
  line-height: 78rpx;
}

.pill {
  display: inline-flex;
  margin: 8rpx 10rpx 0 0;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(201, 122, 31, 0.24);
  border-radius: 999rpx;
  color: #e9b870;
  background: rgba(201, 122, 31, 0.08);
  font-size: 22rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.footer-note {
  margin-top: 40rpx;
  color: #745e43;
  font-size: 22rpx;
  text-align: center;
}
